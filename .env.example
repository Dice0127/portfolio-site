# Copy this file to .env and fill in your real values.
# .env is gitignored — it will NOT be committed or pushed to GitHub.

# Formspree form endpoint (sign up free at https://formspree.io)
# Create a form there, then paste its ID here.
VITE_FORMSPREE_ID=your_formspree_form_id

# Contact details shown on the site
VITE_CONTACT_EMAIL=your_email@example.com
VITE_CONTACT_PHONE=+63 900 000 0000
